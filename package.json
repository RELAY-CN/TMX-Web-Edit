{
  "name": "tmx-web-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rusted Warfare (铁锈战争) TMX 地图网页编辑器",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/obfuscate-dist.mjs && node scripts/verify-dist.mjs",
    "build:fast": "vite build && node scripts/obfuscate-dist.mjs && node scripts/verify-dist.mjs",
    "build:plain": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "obfuscate": "node scripts/obfuscate-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "sync-assets": "node scripts/sync-game-assets.mjs"
  },
  "dependencies": {
    "pako": "^2.1.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "happy-dom": "^20.10.6",
    "javascript-obfuscator": "^5.5.0",
    "terser": "^5.49.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  }
}
